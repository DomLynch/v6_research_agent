[Unit]
Description=V6 Alpha Memo live publisher independent lane
Wants=v6-fullraw-search.service
After=network-online.target v6-fullraw-search.service

[Service]
Type=simple
WorkingDirectory=/opt/v6-research-agent
Environment=PYTHONPATH=/opt/v6-research-agent/src
Environment=V6_RUN_DIR=/var/lib/v6-research-agent/daemon
Environment=V6_TOPICS_FILE=/etc/v6-research-agent-topics.txt
Environment=V6_DAEMON_WRITER=minimax
Environment=V6_DAEMON_MIN_SCORE=85
Environment=V6_DAEMON_MAX_REVISION_RETRIES=4
Environment=V6_DAEMON_SUBMIT_BACKOFF_SECONDS=3600
Environment=V6_DAEMON_SLEEP_SECONDS=60
Environment=V6_DAEMON_MAX_WAITING=6
Environment=V6_DAEMON_ACTIVE_TOPIC_LIMIT=3
Environment=V6_DAEMON_QUERY_LIMIT=8
Environment=V6_DAEMON_PER_QUERY_LIMIT=25
Environment=V6_DAEMON_MIN_COMPLETED_SHAPES=2
Environment=V6_MAX_EMPTY_WAITABLE_QUERIES=2
Environment=V6_FULLRAW_COMPLETED_CACHE_MIN_LIMIT=5
Environment=V6_DAEMON_MAX_CACHE_TOPICS=25
Environment=V6_FULLRAW_PRIORITY=1
Environment=V6_FULLRAW_REQUIRE_COMPLETE=1
Environment=V6_FULLRAW_CACHE_ONLY=1
Environment=V6_FULLRAW_QUEUE_IF_MISSING=1
Environment=V6_FULLRAW_SWEEP_WAIT_SECONDS=0
Environment=V6_FULLRAW_ABSTRACT_BACKFILL=1
Environment=V6_FULLRAW_ABSTRACT_BACKFILL_LIMIT=8
Environment=V6_FULLRAW_SWEEP_CACHE_DIR=/var/lib/v6-research-agent/fullraw-sweep-cache
Environment=V6_FULLRAW_EXTRA_SWEEP_CACHE_DIRS=/var/lib/v5-memo/fullraw-sweep-cache
ExecStart=/bin/bash -lc 'set -a; source /etc/researka-fullraw.env; set +a; export V6_FULLRAW_SEARCH_URL="${V6_FULLRAW_SEARCH_URL:-http://127.0.0.1:9918/search}"; export V6_FULLRAW_TOKEN="${RESEARKA_FULLRAW_TOKEN:-${RESEARKA_FULLRAW_INDEX_TOKEN:-}}"; exec /opt/v6-research-agent/.venv/bin/python -m v6_alpha_memo.daemon'
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
