[Unit]
Description=V6 isolated read-only 5TB fullraw search service
After=network-online.target v5-memo-fullraw-fts-root-mount.service
Wants=network-online.target v5-memo-fullraw-fts-root-mount.service

[Service]
Type=simple
WorkingDirectory=/opt/v5-memo
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=PYTHONPATH=/opt/v5-memo/src
Environment=RESEARKA_FULLRAW_INDEX_HOST=127.0.0.1
Environment=RESEARKA_FULLRAW_INDEX_PORT=9917
Environment=RESEARKA_FULLRAW_FAST_HEALTH=1
Environment=RESEARKA_FULLRAW_SHARD_DIR=/var/lib/v5-memo/fullraw-fts-remote
Environment=RESEARKA_FULLRAW_SHARD_CATALOG_PATH=/var/lib/v5-memo/fullraw-shard-catalog.json
Environment=RESEARKA_FULLRAW_SHARD_CATALOG_TTL_SECONDS=86400
Environment=RESEARKA_FULLRAW_MIN_SHARDS_SEARCHED=1525
Environment=RESEARKA_FULLRAW_MIN_SOURCES_SEARCHED=5
Environment=RESEARKA_FULLRAW_REQUIRE_COMPLETE_SEARCH=1
Environment=RESEARKA_FULLRAW_SWEEP_REQUIRE_COMPLETE=1
Environment=RESEARKA_FULLRAW_ASYNC_SWEEP=1
Environment=RESEARKA_FULLRAW_SWEEP_SHARD_LIMIT=1525
Environment=RESEARKA_FULLRAW_SWEEP_PASS_SHARD_LIMIT=32
Environment=RESEARKA_FULLRAW_SWEEP_MAX_PASSES=5000
Environment=RESEARKA_FULLRAW_SWEEP_WORKERS=2
Environment=RESEARKA_FULLRAW_SWEEP_MAX_INFLIGHT=2
Environment=RESEARKA_FULLRAW_SWEEP_PRIORITY_BURST=0
Environment=RESEARKA_FULLRAW_SWEEP_MAX_QUEUE=4
Environment=RESEARKA_FULLRAW_SWEEP_TTL_SECONDS=604800
Environment=RESEARKA_FULLRAW_SWEEP_CACHE_DIR=/var/lib/v6-research-agent/fullraw-sweep-cache
Environment=RESEARKA_FULLRAW_SWEEP_TIMEOUT_SECONDS=900
Environment=RESEARKA_FULLRAW_SWEEP_SHARD_TIMEOUT_SECONDS=20
Environment=RESEARKA_FULLRAW_SEARCH_ISOLATED=1
Environment=V5_MEMO_FULL_RAW_INDEX_HOST=127.0.0.1
Environment=V5_MEMO_FULL_RAW_INDEX_PORT=9917
ExecStart=/usr/bin/python3 -m v5_memo.fullraw_index serve
Restart=always
RestartSec=10
TimeoutStopSec=120
KillMode=control-group

[Install]
WantedBy=multi-user.target
